QDialog[dialogClass="background"],
QWidget[widgetClass="background"] {
    background: #C5C8CB;
}

QWidget[widgetClass="transparent"] {
    background: transparent;
}

QScrollArea[areaClass="background"] {
    background: #C5C8CB;
    border: none;
}

QScrollArea[areaClass="applicationList"] {
    background: #EAECF0;
    border: none;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

QScrollArea[areaClass="applicationList"] QScrollBar:vertical {
    background: #B5BAC2;
}

QScrollArea[areaClass="applicationList"] QScrollBar::handle:vertical {
    background: #A5A8AD;
}

QScrollArea[areaClass="applicationList"] QScrollBar::handle:vertical:hover {
    background: #828891;
}

QFrame[frameClass="section"] {
    padding: 10px;
    background: #EAECF0;
    border-radius: 20px;
}

QFrame[frameClass="header"] {
    background: #AAAEB4;
    border: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

QLabel[labelClass="h1"] {
    font-style: normal;
    font-size: 24px;
    font-family: 'Instrument Sans';
    color: #3A3C45;
}

QLabel[labelClass="h2"] {
    font-style: normal;
    font-size: 24px;
    color: #000000;
    font-family: 'Instrument Sans';
}

QLabel[labelClass="h3"] {
    font-style: normal;
    font-size: 20px;
    color: #000000;
    font-family: 'Instrument Sans';
}

QLabel[labelClass="h4"] {
    font-style: normal;
    font-size: 16px;
    color: #000000;
    font-family: 'Instrument Sans';
}

QLabel[labelClass="h5"] {
    font-style: normal;
    font-size: 15px;
    color: #000000;
    font-family: 'Instrument Sans';
}

QTreeWidget[treeClass="appLists"]::item,
QListWidget[listClass="appList"]::item,
QLabel[labelClass="h4"] {
    font-style: normal;
    font-size: 18px;
    color: #000000;
    font-family: 'Instrument Sans';
}

QComboBox[comboClass="default"] {
    padding: 10px;
    background: #C5C8CB;
    border-radius: 15px;
    font-family: 'Instrument Sans';
    font-style: normal;
    font-weight: 500;
    font-size: 16px;
    color: #000000;
    padding: 8px 36px 8px 16px;
}

QComboBox[comboClass="default"]:hover {
    background-color: #b8bbbe;
}

QComboBox[comboClass="default"]::drop-down {
   subcontrol-position: top left;
   border: none;
}

QComboBox[comboClass="default"]::down-arrow {
    image: url(:/gui/arrow.svg);
    padding-left: 1em;
}

QComboBox[comboClass="default"] QAbstractItemView {
    padding: 10px;
    background: #C5C8CB;
    border-radius: 15px;
    color: #000000;
}

QLineEdit[lineClass="default"] {
    padding: 10px;
    background: #F3F3F3;
    border: 1px solid #3A3C45;
    border-radius: 15px;
    color: #3A3C45;
    font-family: 'Instrument Sans';
}

QLineEdit[lineClass="schedulePage"] {
    padding: 5px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    color: #030303;
    font-size: 24px;
    font-family: 'Instrument Sans';
}

QLineEdit[lineClass="schedulePage"]:focus {
    background: #F3F3F3;
    border: 1px solid #3A3C45;
}

QLineEdit[lineClass="schedulePage"]:hover {
    background: #F3F3F3;
    border: 1px solid #3A3C45;
}

QPushButton[buttonClass="green"] {
    padding: 10px 10px;
    background: #009081;
    border-radius: 10px;
    font-family: 'Instrument Sans';
    font-style: normal;
    font-weight: 500;
    font-size: 16px;
    color: #F3F3F3;
}

QPushButton[buttonClass="green"]:hover {
    background: #00796d;
}

QScrollArea[areaClass="backgound"] {
    background: #C5C8CB;
}

QListWidget[listClass="sidebar"] {
    padding: 0px;
    background: #AAAEB4;
    font-family: 'Instrument Sans';
    font-style: normal;
    font-weight: 500;
    font-size: 20px;
    color: #23242a;
    outline: none;
}

QListWidget[listClass="sidebar"]::item {
    padding: 10px;
}

QListWidget[listClass="sidebar"]::item:hover,
QListWidget[listClass="sidebar"]::item:selected {
    background-color: #878B91;
    color: #000000;
}

QGroupBox[groupBoxClass="default"] {
    padding: 5px;
    background: #AAAEB4;
    border-radius: 30px;
    color: #3A3C45;
}

QGroupBox[groupBoxClass="default"] QPushButton:checked,
QGroupBox[groupBoxClass="default"] QPushButton:checked:hover {
    background: #EAECF0;
}

QGroupBox[groupBoxClass="default"] QPushButton {
    padding: 10px;
    background: #AAAEB4;
    border-radius: 20px;
    color: #3A3C45;
    font-family: 'Instrument Sans';
    font-style: normal;
    font-weight: 500;
    font-size: 20px;
}

QGroupBox[groupBoxClass="default"] QPushButton:hover {
    background: #8e9296;
}

QPushButton[buttonClass="editAppList"],
QPushButton[buttonClass="deleteAppList"] {
    padding: 0px;
    margin: 0px;
    border: none;
    border-radius: 5px;
    background-color: transparent;
}

QPushButton[buttonClass="editAppList"]:hover {
    background-color: #F8DF79;
}

QPushButton[buttonClass="deleteAppList"]:hover {
    background-color: #E57979;
}

QPushButton[buttonClass="add"] {
    padding: 0px;
    margin: 0px;
    background-color: #009081;
    color: white;
    border: none;
    border-radius: 10px;
}

QPushButton[buttonClass="add"]:hover {
    background-color: #00796d;
}

QGroupBox[groupBoxClass="week"] {
    background: #C5C8CB;
    padding: 10px;
    border: none;
}

QPushButton[buttonClass="day"] {
    padding: 10px;
    width: 40px;
    height: 40px;
    background: #00C8B3;
    border-radius: 20px;
}

QPushButton[buttonClass="day"]:checked {
    background: #00C8B3;
}

QPushButton[buttonClass="day"] {
    min-width: 40px;
    max-width: 40px;
    min-height: 40px;
    max-height: 40px;
    padding: 5px;
    border-radius: 25px;
    background: #878B91;
    font-family: 'Instrument Sans';
    font-style: normal;
    font-weight: 500;
    font-size: 16px;
    color: #F3F3F3;
}

QPushButton[buttonClass="cancel"] {
    padding: 0px;
    background: #C5C8CB;
    border-radius: 10px;
    font-family: 'Instrument Sans';
    font-style: normal;
    font-weight: 500;
    font-size: 16px;
    color: #030303;
}

QPushButton[buttonClass="cancel"]:hover {
    background-color: #AAAEB4;
}

QPushButton[buttonClass="delete"],
QPushButton[buttonClass="create"] {
    padding: 0px;
    border-radius: 10px;
    font-family: 'Instrument Sans';
    font-style: normal;
    font-weight: 500;
    font-size: 16px;
    color: #F3F3F3;
}

QPushButton[buttonClass="create"] {
    background-color: #009081;
}

QPushButton[buttonClass="delete"] {
    background-color: #E57979;
}

QPushButton[buttonClass="create"]:hover {
    background: #00796d;
}

QPushButton[buttonClass="delete"]:hover {
    background-color: #af0606;
}

QPushButton[buttonClass="create"]:disabled {
    background: #AAAEB4;
    color: #3A3C45;
}

QTimeEdit[timeClass="default"] {
    padding: 10px;
    background: #AAAEB4;
    border: none;
    border-radius: 10px;
    font-family: 'Instrument Sans';
    font-weight: 500;
    font-size: 16px;
    color: #030303;
}

QTimeEdit[timeClass="default"]::up-button,
QTimeEdit[timeClass="default"]::down-button {
    width: 0px;
}

ScheduleItem[scheduleItemClass="isActive"] {
    background-color: #F3F3F3;
    padding: 10px;
    border-radius: 20px;
}

ScheduleItem[scheduleItemClass="isNotActive"] {
    background-color: #EAECF0;
    padding: 10px;
    border-radius: 20px;
}

QPushButton[buttonClass="onSchedule"],
QPushButton[buttonClass="editSchedule"], 
QPushButton[buttonClass="deleteSchedule"] {
    background: transparent;
    border: none;
    border-radius: 10px;
}

QPushButton[buttonClass="deleteSchedule"]:hover {
    background: #E57979;
}

QPushButton[buttonClass="editSchedule"]:hover {
    background: #F8DF79;
}

QPushButton[buttonClass="onSchedule"]:checked {
    background: #C7F3DE;
}

QPushButton[buttonClass="onSchedule"]:hover,
QPushButton[buttonClass="onSchedule"]:checked:hover {
    background: #00C8B3;
}

ScheduleItem[scheduleItemClass="isNotActive"] QLabel[labelClass="h2"],
ScheduleItem[scheduleItemClass="isNotActive"] QLabel[labelClass="h3"] {
    color: #878B91;
}

QListWidget[listClass="appList"],
QTreeWidget[treeClass="appLists"] {
    background: transparent;
    border: none;
}

QListWidget[listClass="appList"]::indicator,
QTreeWidget[treeClass="appLists"]::indicator {
    background: white;
}

QListWidget[listClass="appList"]::indicator:hover,
QTreeWidget[treeClass="appLists"]::indicator:hover {
    border: 1px solid #23242a;
}

QListWidget[listClass="appList"]::indicator:checked,
QTreeWidget[treeClass="appLists"]::indicator:checked {
    background: #009081;
    border: 2px solid white;
}

QTreeWidget[treeClass="appLists"]::branch:has-children:closed {
    image: url(:/gui/up-arrow.svg);
}

/* Відкритий вузол */
QTreeWidget[treeClass="appLists"]::branch:has-children:open {
    image: url(:/gui/down-arrow.svg);
}

#scheduleScrollAreaContents,
#scheduleScrollArea {
    background: transparent;
}

QScrollBar::up-arrow,
QScrollBar::down-arrow,
QScrollBar::left-arrow,
QScrollBar::right-arrow,
QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0px;
    height: 0px;
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    width: 8px;
    background: #8e9296;
    margin: 0px;
    border: none;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #3A3C45;
    border-radius: 4px;
    min-height: 30px;
}
